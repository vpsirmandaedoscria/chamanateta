   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass AloneZLabel {
     position 4 0
     size 280 12
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "LABEL"
    }
    ProgressBarWidgetClass AloneZBar {
     position 4 18
     size 280 9
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style "progress"
     "stretch mode" stretch_w
    }
   }
  }
 }
